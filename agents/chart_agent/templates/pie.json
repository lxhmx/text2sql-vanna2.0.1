{
  "type": "pie",
  "name": "饼图",
  "option": {
    "tooltip": {
      "trigger": "item",
      "formatter": "{b}: {c} ({d}%)"
    },
    "legend": {
      "orient": "vertical",
      "right": 10,
      "top": "center",
      "type": "scroll"
    },
    "series": [
      {
        "name": "",
        "type": "pie",
        "radius": ["35%", "55%"],
        "center": ["35%", "50%"],
        "avoidLabelOverlap": true,
        "data": [],
        "label": {
          "show": true,
          "formatter": "{b}\n{d}%",
          "fontSize": 11
        },
        "labelLine": {
          "show": true
        },
        "emphasis": {
          "itemStyle": {
            "shadowBlur": 10,
            "shadowOffsetX": 0,
            "shadowColor": "rgba(0, 0, 0, 0.5)"
          }
        }
      }
    ],
    "color": ["#5b8def", "#a855f7", "#10b981", "#f59e0b", "#ef4444", "#06b6d4", "#8b5cf6", "#ec4899", "#14b8a6", "#f97316"]
